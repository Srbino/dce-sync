#!/usr/bin/env python3
"""Repo-local entry point. After `pip install .`, the console_script declared
in pyproject.toml takes over and this file is no longer involved."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from dce_sync import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
